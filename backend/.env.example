# --- Required ---
# OpenCode gateway key. NEVER commit the real value.
OPENCODE_API_KEY=

# Upstash Redis connection string (rediss://default:<password>@<host>:6379).
# Leave empty for local dev to use the in-memory fallback store.
REDIS_URL=

# Comma-separated CORS whitelist. Set to your Vercel domain in production.
ALLOWED_ORIGINS=http://localhost:5173

# --- Model routing (OpenCode model ids) ---
QUERY_MODEL=deepseek-v4.1-flash
EVAL_MODEL=deepseek-v4.1-flash

# --- Optional tuning ---
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# RATE_LIMIT=2
# MAX_LINKS=25
# MAX_MATCHES=8
# PER_JOB_DELAY=3.0
# CONTACT_LINKEDIN=https://www.linkedin.com/in/harshmankar
# CONTACT_EMAIL=harshrajendramankar@gmail.com
